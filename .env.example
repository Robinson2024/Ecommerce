# Environment variables para desarrollo
DEBUG=True
SECRET_KEY=tech-ecommerce-super-secret-key-2025-development-only
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - Configuración flexible
USE_POSTGRESQL=False
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=tech_ecommerce
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Cache - Configuración flexible  
USE_REDIS=False
REDIS_URL=redis://localhost:6379/0

# Email (Console backend para desarrollo)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@techecommerce.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Storage
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Logging
DJANGO_LOG_LEVEL=DEBUG

# Security
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Site Configuration
SITE_URL=http://localhost:8000

# External APIs
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_LIVE_MODE=False

PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox

# Payment Settings
DEFAULT_PAYMENT_METHOD=stripe
REQUIRE_BILLING_ADDRESS=False
ENABLE_SAVED_CARDS=False

# Sentry (opcional)
SENTRY_DSN=
